# ══════════════════════════════════════════════════════════════════
# Müller Biegetechnik AG — Produktionskalender
# Umgebungsvariablen für die Supabase-Datenbankverbindung
# ══════════════════════════════════════════════════════════════════
#
# SETUP-ANLEITUNG:
# 1. Diese Datei nach ".env.local" kopieren (im gleichen Verzeichnis)
# 2. Werte von Supabase eintragen (siehe unten)
# 3. Bei Vercel: Dashboard → Settings → Environment Variables
#
# ── SUPABASE-KONFIGURATION ─────────────────────────────────────────
#
# Bezugsquelle: https://supabase.com → Ihr Projekt → Settings → API
#
# Project URL (endet auf .supabase.co):
NEXT_PUBLIC_SUPABASE_URL=https://XXXXXXXXXXXXXXXX.supabase.co
#
# Anon/Public Key (beginnt mit "eyJ..."):
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
#
# ══════════════════════════════════════════════════════════════════
# WICHTIG: Vor dem ersten Start das SQL-Schema in Supabase ausführen!
# Das Schema befindet sich als Kommentar in: lib/supabase.ts
# ══════════════════════════════════════════════════════════════════
